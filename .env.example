# ResiliNet configuration. Copy to `.env` and fill values locally.
# Never commit `.env` or real provider credentials.
#
# Only names and safe, non-secret examples belong in this file.

RESILINET_APP_ENV=test
RESILINET_DATABASE_URL=sqlite+aiosqlite:///./resilinet.db
RESILINET_PUBLIC_BASE_URL=http://localhost:8000
RESILINET_INCIDENT_KEY=demo-incident
RESILINET_MOMEN_ORIGINS=["http://localhost:3000"]
RESILINET_LOG_LEVEL=INFO

# Intelligence provider for extraction and critique: openai or nvidia.
# Keep the matching API key below; the other provider's key stays optional.
RESILINET_LLM_PROVIDER=openai

# Run the durable worker inside the FastAPI process. This is the default so a
# free Render web service can process jobs; set false when a dedicated worker
# service runs scripts/run_worker.py.
RESILINET_RUN_WORKER_IN_APP=true

# Optional provider endpoints and models (defaults shown).
RESILINET_AGENTBOXD_BASE_URL=https://api.agentboxd.com
RESILINET_MOJOAUTH_BASE_URL=https://api.mojoauth.com
RESILINET_OPENAI_MODEL=gpt-4.1-mini
RESILINET_OPENAI_BASE_URL=https://api.openai.com/v1
RESILINET_NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Tried in order when the configured model is retired (HTTP 404/410).
RESILINET_NVIDIA_FALLBACK_MODELS=["nvidia/llama-3.3-nemotron-super-49b-v1.5","nvidia/nemotron-3.5-lightning-30b-a3b","openai/gpt-oss-120b"]
RESILINET_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
RESILINET_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Required only when RESILINET_APP_ENV=live. Provide through the environment
# or the Render secret store, never as committed values.
RESILINET_AGENTBOXD_API_KEY=
RESILINET_AGENTBOXD_WEBHOOK_SECRET=

# Optional until the Phase 3 identity/action-page wiring. No adapter consumes
# this key yet, so it is not required to run the email-to-reply path.
RESILINET_MOJOAUTH_API_KEY=

# Enter the key for the provider selected above. OpenAI is used by default;
# set RESILINET_LLM_PROVIDER=nvidia to use the NVIDIA NIM key instead.
RESILINET_OPENAI_API_KEY=
RESILINET_NVIDIA_API_KEY=

# Used to identify geocoding requests to Nominatim in live mode.
RESILINET_NOMINATIM_CONTACT_EMAIL=
